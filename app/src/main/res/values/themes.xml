<resources>
    <style name="Theme.GeoProofCamera" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gp_blue</item>
        <item name="colorPrimaryDark">@color/gp_blue_dark</item>
        <item name="colorAccent">@color/gp_green</item>
        <item name="android:windowBackground">@color/gp_bg_dark</item>
        <item name="android:statusBarColor">@color/gp_bg_dark</item>
        <item name="android:navigationBarColor">@color/gp_bg_dark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <!-- Camera activity: fully transparent status bar (camera fills screen) -->
    <style name="Theme.GeoProofCamera.Camera" parent="Theme.GeoProofCamera">
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Splash: full blue gradient, no title bar -->
    <style name="Theme.GeoProofCamera.Splash" parent="Theme.GeoProofCamera">
        <item name="android:windowBackground">@color/gp_blue</item>
        <item name="android:statusBarColor">@color/gp_blue_dark</item>
        <item name="android:navigationBarColor">@color/gp_blue_dark</item>
    </style>
</resources>
