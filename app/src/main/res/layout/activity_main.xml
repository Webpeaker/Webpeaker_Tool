<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Full-screen camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:scaleType="fillCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top gradient scrim -->
    <View
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@drawable/gradient_top_scrim"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top bar: GPS Lock Pill | Flash | Settings -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- GPS Lock Badge (Pill with semi-transparent background) -->
        <TextView
            android:id="@+id/tvGpsBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_background"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="● GPS Locked"
            android:textColor="#FF00C853"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Top Right Actions Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Flash Toggle Button -->
            <FrameLayout
                android:id="@+id/btnFlash"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/rounded_rect_button"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/ivFlashIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_flash"
                    android:contentDescription="Toggle Flash" />
            </FrameLayout>

            <!-- Settings Button -->
            <FrameLayout
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/rounded_rect_button"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    android:tint="#FFFFFFFF"
                    android:contentDescription="Settings" />
            </FrameLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom gradient scrim (fades out behind the card) -->
    <View
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:background="@drawable/gradient_bottom_scrim"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Live Watermark Card (Overlay above bottomControls) -->
    <LinearLayout
        android:id="@+id/locationCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/watermark_card_background"
        android:padding="12dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left: Static Map Tile Preview Container -->
        <FrameLayout
            android:id="@+id/layoutLiveMap"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/ivLiveMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_photo_placeholder"
                android:contentDescription="Live Satellite Map" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/thumbnail_background" />

            <!-- Mini Google watermark -->
            <TextView
                android:id="@+id/tvGoogleWatermark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"
                android:text="Google"
                android:textColor="#FFFFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:shadowColor="#FF000000"
                android:shadowRadius="2"
                android:shadowDx="1"
                android:shadowDy="1" />
        </FrameLayout>

        <!-- Right: Location Details & Metadata Stack -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title & Company Logo Badge Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📍 Locating…"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Tiny White Pill Company Logo Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/badge_background"
                    android:backgroundTint="#2EFFFFFF"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_company_logo"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GeoProof"
                        android:textColor="#FFFFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Sub-address details -->
            <TextView
                android:id="@+id/tvSubAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Waiting for GPS lock..."
                android:textColor="#FFB0BEC5"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Coordinates (Lat/Long) -->
            <LinearLayout
                android:id="@+id/layoutCoords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lat "
                    android:textColor="#B3FFFFFF"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/tvLatitude"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10.5sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="   Long "
                    android:textColor="#B3FFFFFF"
                    android:textSize="10.5sp"
                    android:layout_marginStart="12dp" />

                <TextView
                    android:id="@+id/tvLongitude"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10.5sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Altitude / Accuracy -->
            <LinearLayout
                android:id="@+id/layoutAltAcc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alt: "
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvAltitude"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="   Acc: "
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginStart="12dp" />

                <TextView
                    android:id="@+id/tvAccuracy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Date & Time live overlay line -->
            <TextView
                android:id="@+id/tvLiveDateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wednesday 03/06/2026 12:10 PM GMT+05:30"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />

            <!-- Weather display live overlay line -->
            <TextView
                android:id="@+id/tvLiveWeather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌤️ Loading weather..."
                android:textColor="#B3FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

    <!-- Photo counter indicator -->
    <TextView
        android:id="@+id/tvPhotoCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/badge_background"
        android:backgroundTint="#4D000000"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text=""
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Controls: Solid Black Bar (Matching screenshot) -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="0dp"
        android:layout_height="124dp"
        android:background="#FF000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Gallery / Thumbnail with rounded corners -->
        <FrameLayout
            android:id="@+id/cardThumbnail"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/thumbnail_background"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/ivThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_photo_placeholder"
                android:contentDescription="Gallery" />
        </FrameLayout>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <!-- Shutter button container -->
        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp">
            <!-- White Outer Ring -->
            <View
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/shutter_ring"
                android:layout_gravity="center" />
            <!-- Solid White Circle Shutter Button -->
            <View
                android:id="@+id/btnCapture"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/shutter_button"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Capture Photo" />
        </FrameLayout>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <!-- Flip Camera Button -->
        <FrameLayout
            android:id="@+id/cardFlipCamera"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/circle_button_background"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/ivFlipCamera"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_flip_camera"
                android:tint="#FFFFFFFF"
                android:contentDescription="Flip Camera" />
        </FrameLayout>
    </LinearLayout>

    <!-- Saving/processing badge overlay -->
    <TextView
        android:id="@+id/tvSavingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_background"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="📸 Saving…"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
